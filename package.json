{
  "name": "how-expensive-is-my-car",
  "version": "1.0.0",
  "private": true,
  "description": "Valuador automatico de autos usados argentinos a partir de publicaciones reales",
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "build": "npm run build --workspace=shared && npm run build --workspace=backend && npm run build --workspace=frontend",
    "start": "npm start --workspace=backend",
    "test": "npm test --workspace=backend",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "install:all": "npm install --workspace=backend && npm install --workspace=frontend"
  },
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.4.2"
  }
}
